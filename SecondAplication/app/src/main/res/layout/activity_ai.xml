<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F0F4F8"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=" Smart Room AI"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#1E88E5"
        android:gravity="center"
        android:layout_marginBottom="24dp" />

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="20dp"
        app:cardElevation="10dp"
        android:layout_marginBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <EditText
                android:id="@+id/etMp2"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="Suprafață (mp2)"
                android:background="#E3F2FD"
                android:paddingHorizontal="16dp"
                android:inputType="numberDecimal" />

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#CFD8DC" android:layout_marginVertical="16dp"/>

            <CheckBox
                android:id="@+id/cbBalcon"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="#1E88E5"
                android:text="Include Balcon Exterior" />

            <Switch
                android:id="@+id/swAerConditionat"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:text="Sistem Climatizare (Aer)" />

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#CFD8DC" android:layout_marginVertical="16dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sistem de Încălzire:"
                android:textStyle="bold"
                android:textColor="#455A64"
                android:layout_marginBottom="8dp" />

            <RadioGroup
                android:id="@+id/rgIncalzire"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <RadioButton android:id="@+id/rbCentrala" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Centrală proprie" android:checked="true" />
                <RadioButton android:id="@+id/rbTermoficare" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Termoficare oraș" />
            </RadioGroup>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <Button
        android:id="@+id/btnSalveaza"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="SALVEAZĂ PROFILUL"
        android:textStyle="bold"
        android:textSize="16sp"
        android:backgroundTint="#1E88E5"
        app:cornerRadius="15dp" />
</LinearLayout>