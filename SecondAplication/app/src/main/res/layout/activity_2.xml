<?xml version="1.0" encoding="utf-8"?>




<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="20dp"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">



    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Adauga o camera"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="24dp" />

    <EditText
        android:id="@+id/etMp2"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="Suprafata in mp2"
        android:inputType="numberDecimal" />

    <CheckBox
        android:id="@+id/cbBalcon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Balcon"
        android:layout_marginTop="16dp" />


    <Switch
        android:id="@+id/swAerConditionat"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Aer conditionat"
        android:layout_marginTop="12dp" />


    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tip incalzire:"
        android:layout_marginTop="15dp" />

    <RadioGroup
        android:id="@+id/rgIncalzire"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <RadioButton
            android:id="@+id/rbCentrala"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Centrala"
            android:checked="true" />

        <RadioButton
            android:id="@+id/rbTermoficare"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Soba" />

        <RadioButton
            android:id="@+id/rbPardoseala"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Incalzire in pardoseala" />
    </RadioGroup>


    <Button
        android:id="@+id/btnSalveaza"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Salveaza Camera"
        android:layout_marginTop="30dp" />


</LinearLayout>